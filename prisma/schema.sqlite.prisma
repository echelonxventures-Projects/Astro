// StarPath Astrology Database Schema - SQLite (Development)
// Use this for local development without needing PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  passwordHash      String?

  // Birth details for astrology calculations
  birthDate         DateTime?
  birthTime         String?   // Stored as "HH:mm" format
  birthPlace        String?
  birthLatitude     Float?
  birthLongitude    Float?
  birthTimezone     String?

  // Subscription status
  subscriptionStatus String   @default("free") // free, premium, cancelled
  stripeCustomerId   String?
  stripeSubscriptionId String?
  subscriptionPlan   String?  // monthly, yearly
  currentPeriodEnd   DateTime?

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  birthCharts       BirthChart[]
  readings          Reading[]
  chatSessions      ChatSession[]
  subscriptions     Subscription[]
  payments          Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BirthChart {
  id              String   @id @default(cuid())
  userId          String
  name            String   @default("My Birth Chart")

  // Input data
  birthDate       DateTime
  birthTime       String
  birthPlace      String
  latitude        Float
  longitude       Float
  timezone        String

  // Calculated data (stored as JSON)
  planets         Json     // All planetary positions
  houses          Json     // House cusps
  aspects         Json     // Major aspects

  // Calculated at
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reading {
  id              String   @id @default(cuid())
  userId          String
  type            String   // daily, love, career, compatibility, transit, natal
  title           String?
  content         String   @db.Text
  input           Json     // Input parameters (birth data, partner data, etc.)
  aiGenerated     Boolean  @default(true)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model ChatSession {
  id              String   @id @default(cuid())
  userId          String
  title           String?
  messages        Json     // Array of {role, content, timestamp}
  metadata        Json?    // User data: name, birthDate, birthTime, birthPlace
  createdAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                  String   @id @default(cuid())
  userId              String
  stripeSubscriptionId String   @unique
  plan                String   // monthly, yearly
  status              String   // active, past_due, canceled, incomplete
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  stripePaymentId   String   @unique
  amount            Int      // In cents
  currency          String   @default("usd")
  status            String   // succeeded, pending, failed
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripePaymentId])
}

model AppSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// AI Provider configuration - fully dynamic
model AIProviderConfig {
  id          String   @id @default(cuid())
  name        String   // Display name (e.g., "Free Plan AI", "Premium AI")
  plan        String?  // Associated subscription plan (free, monthly, yearly, or custom)
  provider    String   @default("ollama") // ollama, anthropic, gemini, openai, etc.
  model       String   @default("llama3.2")
  apiKey      String?  // For paid providers
  ollamaUrl   String?  // For Ollama provider
  baseUrl     String?  // For custom providers
  maxTokens   Int      @default(512)
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  description String?
  metadata    String?  // JSON for additional config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plan])
}

// Configurable regions for multi-region support
model Region {
  id          String   @id @default(cuid())
  name        String   // Display name (e.g., "United States", "Europe", "India")
  key         String   @unique // Internal key (e.g., "us", "eu", "in")
  code        String   @unique // ISO country code or region code
  currency    String   @default("usd") // Default currency for this region
  currencies  String?  // JSON array of supported currencies [{code, symbol, name}]
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  priceMultiplier Float    @default(1.0) // For regional pricing adjustments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([code])
  @@index([isActive])
}

// Configurable subscription plans - fully dynamic pricing
model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String   // Display name (e.g., "Free", "Premium Monthly")
  key             String   @unique // Internal key (e.g., "free", "monthly", "yearly")
  description     String?
  price           Int      @default(0) // Price in cents (base price)
  currency        String   @default("usd") // Base currency
  interval        String?  // monthly, yearly, or null for free
  stripePriceId   String?  // Stripe Price ID for this plan (base)
  stripeProductId String?  // Stripe Product ID
  isActive        Boolean  @default(true)
  isPopular       Boolean  @default(false) // Show "Most Popular" badge
  sortOrder       Int      @default(0) // Order for display
  features        String?  // JSON array of feature strings
  aiConfig        String?  // JSON for AI provider config (provider, model, maxTokens)
  metadata        String?  // JSON for additional config

  // Regional pricing overrides
  regionalPricing String?  // JSON object: { "eu": { price, currency, stripePriceId }, "in": {...} }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  featureAccess   PlanFeatureAccess[]

  @@index([key])
  @@index([isActive])
}

// Configurable features for comparison table
model PlanFeature {
  id          String   @id @default(cuid())
  name        String   // Display name (e.g., "Daily Horoscope")
  key         String   @unique // Internal key (e.g., "daily_horoscope")
  description String?
  category    String?  // Grouping category (e.g., "readings", "support", "ai")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  featureAccess PlanFeatureAccess[]

  @@index([key])
  @@index([isActive])
  @@index([category])
}

// Plan-Feature relationship (which features each plan includes)
model PlanFeatureAccess {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean  @default(true) // Whether this plan has access to this feature
  value     String?  // Optional value (e.g., "3" for "3 AI readings per month")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feature PlanFeature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
}
