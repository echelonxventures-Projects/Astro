// StarPath Astrology Database Schema - PostgreSQL (Production)
// Multi-tenant: every customer-facing table carries a required tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================
// TENANCY
// ===========================================

// A tenant = one white-label customer platform served by this deployment
model Tenant {
  id        String  @id @default(cuid()) // default tenant uses a stable literal id
  slug      String  @unique // subdomain label, e.g. "luna" -> luna.example.com
  name      String
  status    String  @default("active") // active, suspended, pending
  isDefault Boolean @default(false)

  // Platform hierarchy: null = root (super platform). Children may only be
  // configured within their parent's MasterConfig grants.
  parentId  String?
  parent    Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Tenant[] @relation("TenantHierarchy")

  // JSON BrandConfig (colors, tagline, logoUrl, faviconUrl, seo, social) - see src/lib/branding.ts
  branding  Json?
  // JSON TenantSettings (email from-name, per-tenant OAuth keys, analytics id, feature flags)
  settings  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains               TenantDomain[]
  users                 User[]
  birthCharts           BirthChart[]
  readings              Reading[]
  chatSessions          ChatSession[]
  subscriptions         Subscription[]
  payments              Payment[]
  paymentTransactions   PaymentTransaction[]
  notifications         Notification[]
  userDevices           UserDevice[]
  userMemories          UserMemory[]
  astroProfiles         AstroProfile[]
  appSettings           AppSettings[]
  aiProviderConfigs     AIProviderConfig[]
  aiProviderCatalog     AIProviderCatalog[]
  subscriptionPlans     SubscriptionPlan[]
  planFeatures          PlanFeature[]
  paymentGateways       PaymentGateway[]
  regions               Region[]

  @@index([status])
  @@index([parentId])
}

// Hostnames served by a tenant. Two ownership classes:
//  - in_house: <slug>.TENANT_ROOT_DOMAIN (or *.localhost in dev) - ours, auto-verified
//  - custom:   tenant-owned vanity domains - must pass DNS verification before serving
model TenantDomain {
  id                String    @id @default(cuid())
  host              String    @unique // lowercase, no port: "astro.customer.com"
  tenantId          String
  type              String    @default("in_house") // in_house | custom
  status            String    @default("verified") // pending | verified
  verificationToken String? // expected value of TXT record _starpath-verify.<host>
  verifiedAt        DateTime?
  isPrimary         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

// ===========================================
// AUTH (NextAuth)
// ===========================================

// User model with payment gateway fields
model User {
  id                String    @id @default(cuid())
  tenantId          String
  email             String // unique per tenant
  emailVerified     DateTime?
  name              String?
  image             String?
  passwordHash      String?
  role              String    @default("user") // user, moderator, admin, superadmin

  // Birth details for astrology calculations
  birthDate         DateTime?
  birthTime         String?   // Stored as "HH:mm" format
  birthPlace        String?
  birthLatitude     Float?
  birthLongitude    Float?
  birthTimezone     String?

  // Subscription status
  subscriptionStatus String   @default("free") // free, premium, cancelled
  stripeCustomerId   String?
  stripeSubscriptionId String?
  razorpayCustomerId String?  // Razorpay customer ID
  subscriptionPlan   String?  // monthly, yearly
  currentPeriodEnd   DateTime?
  preferredGateway   String?  // User's preferred payment gateway key

  // Gateway metadata (JSON for storing additional gateway-specific data)
  gatewayMetadata    String?  // JSON: { stripe: {}, razorpay: {}, ... }

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts          Account[]
  sessions          Session[]
  birthCharts       BirthChart[]
  readings          Reading[]
  chatSessions      ChatSession[]
  subscriptions     Subscription[]
  payments          Payment[]
  transactions      PaymentTransaction[]
  devices           UserDevice[]
  memories          UserMemory[]
  astroProfiles     AstroProfile[]
  notifications     Notification[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@index([subscriptionStatus])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================================
// DOMAIN DATA (tenant-scoped)
// ===========================================

model BirthChart {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  profileId       String?  // Optional link to AstroProfile
  name            String   @default("My Birth Chart")

  // Input data
  birthDate       DateTime
  birthTime       String
  birthPlace      String
  latitude        Float
  longitude       Float
  timezone        String

  // Calculated data (stored as JSON)
  planets         Json     // All planetary positions
  houses          Json     // House cusps
  aspects         Json     // Major aspects

  // Calculated at
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         AstroProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([profileId])
}

model Reading {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  profileId       String?  // Optional link to AstroProfile
  type            String   // daily, love, career, compatibility, transit, natal
  title           String?
  content         String   @db.Text
  input           Json     // Input parameters (birth data, partner data, etc.)
  aiGenerated     Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         AstroProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId, type])
  @@index([profileId])
  @@index([createdAt])
}

model ChatSession {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  title           String?
  messages        Json     // Array of {role, content, timestamp}
  metadata        Json?    // User data: name, birthDate, birthTime, birthPlace
  createdAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([lastActiveAt])
}

model Subscription {
  id                  String   @id @default(cuid())
  tenantId            String
  userId              String
  stripeSubscriptionId String   @unique
  plan                String   // monthly, yearly
  status              String   // active, past_due, canceled, incomplete
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([stripeSubscriptionId])
}

// Payment audit log for comprehensive transaction tracking
model PaymentAuditLog {
  id                String   @id @default(cuid())
  action            String   // payment_intent_created, payment_captured, refund_processed, etc.
  tenantId          String?
  userId            String?
  transactionId     String?
  gateway           String?
  amount            Int?
  currency          String?
  status            String   // success, failure, pending, warning
  ipAddress         String?
  userAgent         String?
  metadata          String?  @db.Text // JSON for additional data
  error             String?
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([transactionId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@index([gateway])
}

model Payment {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  stripePaymentId   String   @unique
  amount            Int      // In cents
  currency          String   @default("usd")
  status            String   // succeeded, pending, failed
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([stripePaymentId])
}

// Application settings for configurable features (unique per tenant)
model AppSettings {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// AI Provider configuration - fully dynamic, per tenant
model AIProviderConfig {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // Display name (e.g., "Free Plan AI", "Premium AI")
  plan        String?  // Associated subscription plan (free, monthly, yearly, or custom)
  provider    String   @default("ollama") // ollama, anthropic, gemini, openai, etc.
  model       String   @default("llama3.2")
  apiKey      String?  @db.Text // For paid providers
  ollamaUrl   String?  // For Ollama provider
  baseUrl     String?  // For custom providers
  maxTokens   Int      @default(512)
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  description String?
  metadata    String?  // JSON for additional config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([plan])
  @@index([provider])
}

// Per-tenant AI provider catalog: the source of truth for which providers/models
// this tenant offers. Adding a new OpenAI-compatible vendor requires NO code -
// just a catalog row with kind "openai-compatible" and a baseUrl.
model AIProviderCatalog {
  id           String   @id @default(cuid())
  tenantId     String
  key          String // referenced by AIProviderConfig.provider
  label        String // display name in admin UI
  kind         String   @default("openai-compatible") // openai-compatible | ollama | anthropic | gemini | opencode
  baseUrl      String?  // openai-compatible/ollama/opencode: server URL; anthropic/gemini: optional custom endpoint
  apiKey       String?  @db.Text
  models       String?  @db.Text // JSON array of model ids offered for this provider
  capabilities String?  // JSON array e.g. ["vision"]
  options      String?  @db.Text // JSON: { extraHeaders, noAuth, checkUrl, priority }
  enabled      Boolean  @default(true)
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([enabled])
}

// Configurable regions/currencies - per tenant (each platform picks its markets)
model Region {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // Display name (e.g., "United States", "Europe", "India")
  key         String   // Internal key (e.g., "us", "eu", "in") - unique per tenant
  code        String   // ISO country code or region code - unique per tenant
  currency    String   @default("usd") // Default currency for this region
  currencies  String?  // JSON array of supported currencies [{code, symbol, name}]
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  priceMultiplier Float    @default(1.0) // For regional pricing adjustments
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([key])
  @@index([code])
  @@index([isActive])
}

// Configurable subscription plans - fully dynamic pricing, per tenant
model SubscriptionPlan {
  id              String   @id @default(cuid())
  tenantId        String
  name            String   // Display name (e.g., "Free", "Premium Monthly")
  key             String   // Internal key (e.g., "free", "monthly", "yearly") - unique per tenant
  description     String?
  price           Int      @default(0) // Price in cents (base price)
  currency        String   @default("usd") // Base currency
  interval        String?  // monthly, yearly, or null for free
  stripePriceId   String?  // Stripe Price ID for this plan (base)
  stripeProductId String?  // Stripe Product ID
  isActive        Boolean  @default(true)
  isPopular       Boolean  @default(false) // Show "Most Popular" badge
  tier            String   @default("free") // free | paid - drives "is this an upgrade" UI logic
  sortOrder       Int      @default(0) // Order for display
  features        String?  // JSON array of feature strings
  aiConfig        String?  // JSON for AI provider config (provider, model, maxTokens)
  metadata        String?  // JSON for additional config

  // Regional pricing overrides
  regionalPricing String?  // JSON object: { "eu": { price, currency, stripePriceId }, "in": {...} }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureAccess   PlanFeatureAccess[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([isActive])
}

// Configurable features for comparison table, per tenant
model PlanFeature {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // Display name (e.g., "Daily Horoscope")
  key         String   // Internal key (e.g., "daily_horoscope") - unique per tenant
  description String?
  category    String?  // Grouping category (e.g., "readings", "support", "ai")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureAccess PlanFeatureAccess[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([isActive])
  @@index([category])
}

// Plan-Feature relationship (which features each plan includes)
model PlanFeatureAccess {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean  @default(true) // Whether this plan has access to this feature
  value     String?  // Optional value (e.g., "3" for "3 AI readings per month")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feature PlanFeature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
}

// Payment Gateway configuration - supports Stripe, Razorpay, PayPal, etc. (per tenant)
model PaymentGateway {
  id                String   @id @default(cuid())
  tenantId          String
  name              String   // Display name (e.g., "Stripe", "Razorpay")
  key               String   // Internal key (stripe, razorpay, paypal) - unique per tenant
  description       String?
  apiKey            String?  @db.Text // Encrypted API key
  apiSecret         String?  @db.Text // Encrypted API secret
  webhookSecret     String?  @db.Text // Encrypted webhook signing secret
  publicKey         String?  // Public key for client-side (e.g., Razorpay Key ID)
  isEnabled         Boolean  @default(true)
  isDefault         Boolean  @default(false)
  supportedCurrencies String? // JSON array: ["USD", "EUR", "INR"]
  supportedCountries  String? // JSON array: ["US", "GB", "IN"]
  config            String?  @db.Text // JSON for provider-specific config
  testMode          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentMethods    PaymentMethod[]
  gatewayPlans      GatewayPlan[]
  transactions      PaymentTransaction[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([key])
  @@index([isEnabled])
}

// Payment Methods available per gateway (UPI, Cards, Netbanking, etc.)
model PaymentMethod {
  id                String   @id @default(cuid())
  gatewayId         String
  name              String   // Display name (e.g., "UPI", "Credit Card")
  key               String   // Internal key (upi, card, netbanking, wallet, bnpl)
  description       String?
  icon              String?  // Icon name or URL
  isEnabled         Boolean  @default(true)
  sortOrder         Int      @default(0)
  supportedCurrencies String? // JSON array of supported currencies
  supportedCountries  String? // JSON array of supported countries
  config            String?  // JSON for method-specific config
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  gateway           PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@unique([gatewayId, key])
  @@index([gatewayId])
  @@index([isEnabled])
}

// Gateway-specific plan configuration (links plans to gateway plan IDs)
model GatewayPlan {
  id                String   @id @default(cuid())
  gatewayId         String
  planId            String   // Reference to SubscriptionPlan.key
  gatewayPlanId     String   // External plan ID (Stripe Price ID, Razorpay Plan ID)
  name              String
  description       String?
  price             Int      // Price in smallest currency unit
  currency          String   // ISO currency code
  interval          String   // monthly, yearly, etc.
  isActive          Boolean  @default(true)
  isPopular         Boolean  @default(false)
  sortOrder         Int      @default(0)
  features          String?  // JSON array of features
  regionalPricing   String?  // JSON for regional pricing overrides
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  gateway           PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  transactions      PaymentTransaction[]

  @@unique([gatewayId, gatewayPlanId])
  @@index([gatewayId])
  @@index([isActive])
}

// Unified payment transactions across all gateways
model PaymentTransaction {
  id                  String   @id @default(cuid())
  tenantId            String
  userId              String
  gatewayId           String
  gatewayPlanId       String?
  amount              Int      // Amount in smallest currency unit
  currency            String   // ISO currency code
  gatewayTransactionId String  // External transaction ID
  status              String   // pending, success, failed, refunded, disputed
  paymentMethod       String?  // Method used (upi, card, etc.)
  errorCode           String?  // Error code if failed
  errorMessage        String?  // Error message if failed
  metadata            String?  @db.Text // JSON for additional data
  refundedAmount      Int      @default(0)
  refundReason        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway             PaymentGateway   @relation(fields: [gatewayId], references: [id])
  gatewayPlan         GatewayPlan?     @relation(fields: [gatewayPlanId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([gatewayId])
  @@index([status])
  @@index([gatewayTransactionId])
  @@index([createdAt])
}

// ===========================================
// DEVICE & SESSION MANAGEMENT
// ===========================================

// Active user sessions for device tracking
model UserDevice {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  deviceName        String?  // e.g., "MacBook Pro", "iPhone 15"
  deviceType        String?  // desktop, mobile, tablet
  browser           String?  // Chrome, Safari, Firefox
  os                String?  // macOS, iOS, Windows, Android
  ipAddress         String?
  location          String?  // City, Country (from IP)
  userAgent         String?
  sessionId         String   @unique // Reference to NextAuth session
  lastActiveAt      DateTime @default(now())
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isActive])
  @@index([lastActiveAt])
}

// ===========================================
// USER MEMORY SYSTEM
// ===========================================

// Persistent memory for AI conversations
model UserMemory {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  category          String   // preference, preference_astro, preference_chat, fact, insight
  key               String   // e.g., "favorite_zodiac", "preferred_reading_style"
  value             String   @db.Text // The stored memory value
  source            String?  // Where this memory came from: chat, profile, chart
  confidence        Float    @default(1.0) // How confident we are (0-1)
  importance        Int      @default(1) // Priority level (1-10)
  expiresAt         DateTime? // Optional expiration for temporary memories
  lastUsedAt        DateTime @default(now())
  useCount          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, key])
  @@index([tenantId])
  @@index([userId])
  @@index([category])
  @@index([importance])
}

// ===========================================
// SUB-PROFILES (MULTIPLE PROFILES)
// ===========================================

// Astrological profiles for family members or different people under one account
model AstroProfile {
  id                String   @id @default(cuid())
  tenantId          String   // Owner tenant
  userId            String   // Owner account
  name              String   // Profile name: "My Chart", "Spouse", "Child"
  relationship      String?  // self, spouse, child, parent, friend, other
  isDefault         Boolean  @default(false)

  // Birth details
  birthDate         DateTime
  birthTime         String   // "HH:mm" format
  birthPlace        String
  latitude          Float
  longitude         Float
  timezone          String

  // Gender for specific readings (optional)
  gender            String?  // male, female, other

  // Photo (optional)
  photoUrl          String?

  // Notes about this person
  notes             String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthCharts       BirthChart[]
  readings          Reading[]

  @@index([tenantId])
  @@index([userId])
  @@index([isDefault])
}

// ===========================================
// NOTIFICATION SYSTEM
// ===========================================

model Notification {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  type              String   // daily_horoscope, reading_reminder, payment, system
  title             String
  message           String   @db.Text
  data              String?  @db.Text // JSON payload
  isRead            Boolean  @default(false)
  readAt            DateTime?
  createdAt         DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
