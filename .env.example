# =============================================================
# StarPath Astrology - Platform Configuration (.env.example)
# Multi-tenant white-label astrology SaaS on Next.js 16 + PostgreSQL
# Copy to .env, fill secrets, run: npx prisma migrate deploy && npm run db:seed
# =============================================================

# =============================================================
# DATABASE (PostgreSQL only - SQLite is no longer supported)
# =============================================================
# App connection (pooler-safe) and direct migration connection:
DATABASE_URL="postgresql://starpath:CHANGE_ME@localhost:5432/starpath?schema=public"
DIRECT_URL="postgresql://starpath:CHANGE_ME@localhost:5432/starpath?schema=public"

# Connection pool tuning (Prisma):
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000

# =============================================================
# NEXTAUTH (tenant-aware - see docs/MULTI_TENANCY.md)
# =============================================================
# Base URL of the ROOT platform; Secure cookies derive from its protocol:
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
# REQUIRED for multi-tenant hostnames (browser sign-in on any tenant domain):
NEXTAUTH_TRUST_HOST="true"

# =============================================================
# MULTI-TENANCY
# =============================================================
# Subdomains of this domain map to tenant slugs (acme.starpath.app -> "acme").
# Leave unset to rely on exact TenantDomain rows + *.localhost dev magic.
TENANT_ROOT_DOMAIN=""

# Encrypts payment gateway API keys / secrets at rest. >=32 chars required in production:
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# =============================================================
# REDIS (optional but recommended: cache + distributed rate limiting)
# =============================================================
REDIS_URL="redis://:CHANGE_ME@localhost:6379"
CACHE_ENABLED=true
CACHE_KEY_PREFIX="starpath"

# =============================================================
# PAYMENT GATEWAYS (env keys seed the DEFAULT tenant only; every other
# platform configures its own keys in /admin/payments)
# =============================================================
# Stripe - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Razorpay (India) - https://dashboard.razorpay.com
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# PayPal - https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT=sandbox   # or "live"

# Fraud detection
FRAUD_DETECTION_ENABLED=true
MAX_TRANSACTION_AMOUNT=100000   # cents ($1000)
PAYMENT_ENCRYPTION_KEY=""       # openssl rand -base64 32
HTTPS_ENABLED=true

# =============================================================
# AI PROVIDERS (bootstrap values; runtime truth = per-tenant
# AIProviderCatalog managed at /settings -> Providers)
# =============================================================
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""
OLLAMA_URL="http://localhost:11434"
OPENCODE_URL="http://localhost:8080"

# =============================================================
# OAUTH LOGIN PROVIDERS (root-platform defaults; sub-platforms use their own
# via Tenant.settings.oauth - editable through Master Config / provision grants)
# =============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# =============================================================
# MEDIA & EMAIL
# =============================================================
# Cloudinary - brand asset uploads (falls back to /public/uploads when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Resend - transactional email
RESEND_API_KEY=""

# =============================================================
# OBSERVABILITY
# =============================================================
LOG_LEVEL="info"               # fatal|error|warn|info|debug|trace
LOG_PRISMA_QUERIES=false
# Sentry
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="starpath-astrology"
ERROR_REPORTING_ENDPOINT=""
# Client-side metrics
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_APP_VERSION=0.1.0
APP_VERSION=0.1.0
ANALYZE=false

# =============================================================
# BACKUP JOB (scripts/backup; DB_PATH only used by legacy sqlite file backup)
# =============================================================
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=""
BACKUP_S3_BUCKET=""
AWS_REGION=""
DB_PATH="prisma/prod.db"

# =============================================================
# MONITORING STACK (docker compose -f docker-compose.monitoring.yml)
# =============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=http://localhost:3001
