# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# OPTION 1: SQLite (Local Development - Easiest)
DATABASE_URL="file:./dev.db"

# OPTION 2: PostgreSQL (Production or Advanced Dev)
# Uncomment and configure these for PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starpathastrology?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/starpathastrology?schema=public"

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
# For production: Update to your production domain (e.g., https://starpathastrology.com)
NEXTAUTH_URL="http://localhost:3000"
# Generate new secret for production: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ===========================================
# STRIPE CONFIGURATION (Payments)
# ===========================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# ===========================================
# PAYPAL CONFIGURATION (Alternative Payments)
# ===========================================
# Get these from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT=sandbox # or "live" for production

# ===========================================
# FRAUD DETECTION CONFIGURATION
# ===========================================
FRAUD_DETECTION_ENABLED=true
MAX_TRANSACTION_AMOUNT=100000 # cents ($1000)

# ===========================================
# PAYMENT SECURITY CONFIGURATION
# ===========================================
# Generate with: openssl rand -base64 32
PAYMENT_ENCRYPTION_KEY=""
HTTPS_ENABLED=true

# ===========================================
# ANTHROPIC CONFIGURATION (AI Readings)
# ===========================================
# Get your API key from https://console.anthropic.com
# Leave empty if using Ollama (free, local AI)
ANTHROPIC_API_KEY=""

# ===========================================
# GOOGLE OAUTH (Optional - for Google Sign-In)
# ===========================================
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# REDIS CACHE CONFIGURATION (Optional - but recommended)
# ===========================================
# Set CACHE_ENABLED=false to disable caching
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true

# ===========================================
# OPTIONAL SERVICES
# ===========================================
# Email (Resend) - for future email features
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=""

# Cloudinary - for palmistry/face reading image uploads
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================

# Sentry Configuration (Error Tracking)
# Get DSN from https://sentry.io/settings/projects/
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=starpath-astrology

# Web Vitals Analytics (Optional)
# Set endpoint to receive Web Vitals metrics
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# Application Version (used in health checks)
NEXT_PUBLIC_APP_VERSION=0.1.0

# Bundle Analyzer (set to true to analyze bundle size)
ANALYZE=false

# ===========================================
# MONITORING STACK (Docker Compose)
# ===========================================

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=starpath123
GRAFANA_ROOT_URL=http://localhost:3001
