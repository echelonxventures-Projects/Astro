# ===========================================
# Docker Build Context Exclusions
# ===========================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
.next
out
dist

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!README.md
CONTRIBUTING.md
CHANGELOG.md
LICENSE
docs/

# Environment files
.env
.env.*
!.env.example

# Database files
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.idea
.vscode
*.sublime-project
*.sublime-workspace

# Testing
coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
__mocks__

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Docker files (don't include in context)
docker-compose*.yml
Dockerfile*
.docker

# Secrets
secrets/
*.pem
*.key
*.crt

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# TypeScript build info
tsconfig.tsbuildinfo
